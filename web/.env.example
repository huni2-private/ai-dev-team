# AI Dev Team — 환경 변수 템플릿
# 이 파일을 .env.local로 복사하고 실제 값을 입력하세요.
# cp .env.example .env.local

# ─── Supabase ─────────────────────────────────────────────────────
# 1. https://supabase.com 접속 → 새 프로젝트 생성
# 2. Settings → API 에서 아래 값 확인
# 3. web/supabase/schema.sql 을 SQL Editor에서 실행

# 프로젝트 URL (Settings → API → Project URL)
NEXT_PUBLIC_SUPABASE_URL=https://your-project-id.supabase.co

# service_role 키 (Settings → API → Project API keys → service_role)
# 절대 클라이언트에 노출하지 마세요 — 서버 사이드 전용
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here

# ─── Next.js ──────────────────────────────────────────────────────
NEXT_PUBLIC_APP_URL=http://localhost:3000
